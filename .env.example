# Magisor Environment Variables Template
# Copy this file to '.env' and fill in any secrets needed.
# Note: API keys are user-supplied via the app settings
# and are stored in the OS secure keystore. You do NOT need to set them here.

# Runtime environment
MAGISOR_ENV=development
LOG_LEVEL=INFO

# --- AI Model Selection ---
# Override the default model for each provider.
# These values are read at runtime and can be changed without rebuilding.

# Google Gemini model (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Anthropic Claude model (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# Groq model (default: llama-3.2-11b-vision-preview)
GROQ_MODEL=llama-3.2-11b-vision-preview

# --- API Keys (optional, managed via in-app Settings UI) ---
GEMINI_API_KEY=
